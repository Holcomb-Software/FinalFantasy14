<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalFantasy14.Update.Update"
             Title="Update">
    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Label Text="Script Progress:"
               FontSize="18"
               HorizontalOptions="Center"/>

        <ProgressBar Progress="{Binding ScriptProgress}"
                     ProgressColor="DeepSkyBlue"
                     HeightRequest="12"/>

        <Label Text="{Binding StatusText}"
               HorizontalOptions="Center"
               TextColor="Gray"/>

        <Button Text="Run Script"
                Command="{Binding RunScriptCommand}"
                IsEnabled="{Binding IsNotRunning}"
                HorizontalOptions="Center"
                WidthRequest="200"/>
        
    </VerticalStackLayout>
</ContentPage>