<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalFantasy14.Weapons.WeaponsMain"
             Title="WeaponMain">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to Weapons Main Screen!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button Text="Gladiator"
                Clicked="Button_Clicked"/>

        <Rectangle Fill="black" HeightRequest="5" WidthRequest="1000"/>

        <Button Text="Warrior"
                Clicked="Button_Clicked_1"/>

        <Rectangle Fill="black" HeightRequest="5" WidthRequest="1000"/>

        <Button Text="Marauder"
                Clicked="Button_Clicked_2"/>

        <Rectangle Fill="black" HeightRequest="5" WidthRequest="1000"/>

    </VerticalStackLayout>
</ContentPage>