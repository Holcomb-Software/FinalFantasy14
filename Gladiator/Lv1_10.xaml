        <Button Text="Halicarnassus Sword"
                ImageSource="FinalFantasy14.Resources.Images.Weapons.HalicarnassusSword.png"
                Clicked="Button_Clicked_3"/>

        <Button Text="Tarnished Fanged Wolf"
                ImageSource="FinalFantasy14.Resources.Images.Weapons.TarnishedFangedWolf.png"
