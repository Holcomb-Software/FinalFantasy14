<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalFantasy14.Gladiator.Lv1_10"
             Title="Lv1_10">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to Levels 1-10 Weapon List for Gladiators!"
            VerticalOptions="Center" 
            HorizontalOptions="Center"/>

        <Button Text="Ash Macuahuitl"
                ImageSource="FinalFantasy14.Resources.Images.Weapons.AshMacuahuitl.png"
