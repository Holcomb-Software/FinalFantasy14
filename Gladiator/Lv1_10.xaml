        <Button Text="Viking Sword"
                ImageSource="FinalFantasy14.Resources.Images.Weapons.VikingSword.png"
                Clicked="Button_Clicked_9"/>

        <Button Text="Bronze Bastard Sword"
                ImageSource="FinalFantasy14.Resources.Images.Weapons.BronzeBastardSword.png"
                Clicked="Button_Clicked_8"/>

        <Button Text="Weathered Shortsword"
                ImageSource="FinalFantasy14.Resources.Images.Weapons.WeatheredShortsword.png"
