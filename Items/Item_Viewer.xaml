<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalFantasy14.Items.Item_Viewer"
             Title="Item_Viewer"
             BackgroundColor="#1A1A1A">
    <ScrollView>
        <Border Margin="16" Padding="16" BackgroundColor="#2A2A2A" Stroke="#D4B106" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="12">
                <!-- Header -->
                <HorizontalStackLayout Spacing="12">
                    <Image Source="{Binding ImageUrl}" WidthRequest="48" HeightRequest="48"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#F5C542"/>
                        <Label Text="{Binding ClassName, StringFormat='Class: {0}'}" TextColor="#A0A0A0"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#444444"/>

                <!-- Stats Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding ItemLevel, StringFormat='Item Level: {0}'}" TextColor="#E0E0E0"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding LevelReq, StringFormat='Requires Lv. {0}'}" TextColor="#E0E0E0"/>
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Attack, StringFormat='Physical Damage: {0}'}" TextColor="#E0E0E0"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Speed, StringFormat='Delay: {0:F2}'}" TextColor="#E0E0E0"/>
                </Grid>

                <BoxView HeightRequest="1" Color="#444444"/>

                <!-- Stat Bonuses -->
                <Label Text="Bonuses:" FontAttributes="Bold" TextColor="#87CEFA"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding StatBonuses}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}" TextColor="#98FB98" Margin="0,2"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>